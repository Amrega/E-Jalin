<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Koridor 1: Koridor Metropolitan Surabaya - Malang Raya</name>
    <description>Peta jaringan jalan Koridor 1 berdasarkan Peta Pengembangan Wilayah Strategis Jawa Timur (Surabaya - Sidoarjo - Pasuruan - Malang - Batu)</description>

    <!-- Gaya Garis Utama Koridor 1 (Biru sesuai warna panah di peta) -->
    <Style id="koridor1Style">
      <LineStyle>
        <color>ffff6600</color> <!-- Biru terang (AABBGGRR) -->
        <width>6</width>
      </LineStyle>
    </Style>

    <!-- Gaya Titik Simpul Kota/Kawasan -->
    <Style id="simpulKoridor1Style">
      <IconStyle>
        <color>ffffaa00</color>
        <scale>1.2</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/blu-stars.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Ruas Jalan Koridor 1 -->
    <Placemark>
      <name>Koridor 1: Metropolitan Surabaya - Malang Raya</name>
      <description>
        <![CDATA[
          <b>Nama Koridor:</b> Koridor 1 - Koridor Metropolitan Surabaya - Malang Raya<br/>
          <b>Lintasan Wilayah:</b> Kota Surabaya - Kab. Sidoarjo - Kab. Pasuruan - Kab. Malang - Kota Malang - Kota Batu<br/>
          <b>Status Jalan:</b> Jalan Nasional Arteri Primer (Poros Tengah Utara-Selatan)<br/>
          <b>Panjang Estimasi:</b> ± 112 km<br/>
          <b>Keterangan Peta:</b> Menghubungkan pusat pertumbuhan metropolitan Gerbangkertosusila (Surabaya-Sidoarjo) dengan kawasan wisata & agropolitan Malang Raya.
        ]]>
      </description>
      <ExtendedData>
        <Data name="nomor_koridor"><value>1</value></Data>
        <Data name="nama_koridor"><value>Koridor Metropolitan Surabaya - Malang Raya</value></Data>
        <Data name="lintasan_kota"><value>Surabaya - Sidoarjo - Pasuruan - Malang - Batu</value></Data>
        <Data name="panjang_km"><value>112.0</value></Data>
        <Data name="status_jalan"><value>Jalan Nasional / Arteri Primer</value></Data>
      </ExtendedData>
