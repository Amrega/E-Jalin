<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Koridor 2: Wilayah Tengah / Antar Pegunungan (Smart Village &amp; Valley)</name>
    <description>Peta Koridor 2 Jawa Timur sesuai perencanaan strategis: Koridor Kota Besar, Menengah, dan Kecil di Wilayah Tengah/Antar Pegunungan (Ngawi - Madiun - Nganjuk - Jombang - Mojokerto - Kediri - Tulungagung - Blitar - Malang - Probolinggo - Lumajang - Jember - Bondowoso - Situbondo).</description>

    <!-- Gaya Garis Utama Koridor 2A (Ungu/Biru Tengah) -->
    <Style id="koridor2MainStyle">
      <LineStyle>
        <color>ffd45a6a</color> <!-- Ungu-biru sesuai panah Koridor 2 di peta -->
        <width>6</width>
      </LineStyle>
    </Style>

    <!-- Gaya Garis Cabang Koridor 2B (Lembah Brantas: Kertosono - Kediri - Tulungagung - Blitar - Malang) -->
    <Style id="koridor2BranchStyle">
      <LineStyle>
        <color>ffe88494</color> <!-- Ungu muda -->
        <width>5</width>
      </LineStyle>
    </Style>

    <!-- Gaya Titik Simpul Kota -->
    <Style id="simpulKoridor2Style">
      <IconStyle>
        <color>ffffaa55</color>
        <scale>1.15</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Folder>
      <name>Jalur Jalan Koridor 2</name>

      <!-- Jalur 2A: Poros Utama Tengah (Ngawi - Madiun - Nganjuk - Jombang - Mojokerto - Pasuruan - Probolinggo - Lumajang - Jember - Bondowoso - Situbondo) -->
