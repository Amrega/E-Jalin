          <![CDATA[
            <b>Nama Koridor:</b> Koridor 2 - Wilayah Tengah / Antar Pegunungan (Smart Village &amp; Valley)<br/>
            <b>Kode Segmen:</b> KDR-JTM-02A<br/>
            <b>Lintasan Kota:</b> Ngawi - Madiun - Nganjuk - Jombang - Mojokerto - Pasuruan - Probolinggo - Lumajang - Jember - Bondowoso - Situbondo<br/>
            <b>Fungsi:</b> Penghubung kota besar, menengah, dan kecil wilayah tengah Jawa Timur<br/>
            <b>Panjang Estimasi:</b> ± 435 km
          ]]>
        </description>
        <ExtendedData>
